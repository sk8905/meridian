# Static-asset HTTP headers for Cloudflare Workers Assets.
#
# The app HTML documents must ALWAYS revalidate so a fresh deploy's index.html —
# and the bumped ?v= asset references it carries — is picked up immediately,
# instead of a stale cached HTML page pinning the old ?v= JS/CSS/data. These
# documents are served directly by the asset system BEFORE the Worker runs, so
# the Worker cannot set their cache headers; this file does.
#
# no-cache = the browser/edge may store the page but MUST revalidate with the
# origin before using it (ETag → cheap 304 when unchanged), so a new deploy shows
# up on the next load. Fingerprinted JS/CSS/data are versioned by their ?v= tokens
# and keep the default long cache — only these HTML entry points are pinned here.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/credit/
  Cache-Control: no-cache
/credit/index.html
  Cache-Control: no-cache
/legal/
  Cache-Control: no-cache
/legal/index.html
  Cache-Control: no-cache
/macro/
  Cache-Control: no-cache
/macro/index.html
  Cache-Control: no-cache
/menu/
  Cache-Control: no-cache
/menu/index.html
  Cache-Control: no-cache
/v2/
  Cache-Control: no-cache
/v2/index.html
  Cache-Control: no-cache

# The shared data modules are revalidated here and imported WITHOUT a ?v= token
# (see HOUSE_STYLE T1). Because every importer uses the same tokenless URL, each
# data module is a SINGLE instance (the old ?v= drift that double-instanced a
# module and blanked a page is now impossible), and no-cache guarantees a refresh
# is always picked up (cheap 304 via ETag when unchanged). This is what lets the
# 5×/day refresh routine touch ONLY these data files — never a token in code — so
# routine commits and session commits no longer collide. Keep in sync with the
# refresh-routines cache-buster note.
/credit/js/data.js
  Cache-Control: no-cache
/legal/js/data.js
  Cache-Control: no-cache
/macro/js/content.js
  Cache-Control: no-cache
/dashboard/js/data.js
  Cache-Control: no-cache
/ft.js
  Cache-Control: no-cache
/newsletters.js
  Cache-Control: no-cache
/briefings.js
  Cache-Control: no-cache

# The service worker and manifest must revalidate so push/behaviour updates
# apply on the next launch instead of being pinned by the default long cache.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
